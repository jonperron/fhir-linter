{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "fhir-linter",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source)].version"
        },
        {
          "type": "json",
          "path": "bindings/typescript/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bindings/typescript/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "bindings/typescript/package-lock.json",
          "jsonpath": "$.packages[\"\"].version"
        }
      ]
    }
  }
}
